#!/bin/sh
# pre-commit：检查本次暂存的文件，自动修复可安全修复的问题后重新暂存
set -e
npx biome check --no-errors-on-unmatched --staged --write || {
	echo "biome check 存在无法自动修复的问题，commit 被拦截。运行 npm run format 后重试。"
	exit 1
}
changed=$(git diff --name-only)
[ -n "$changed" ] && git add $changed

# 测试：快速验证，拦截破坏性提交
npm test 2>&1 | tail -3 || {
	echo "vitest 失败，commit 被拦截。运行 npm test 查看详情。"
	exit 1
}
exit 0
